  {
    "Id": "TC_SU_06",
    "Title": "Full name contains digits",
    "Username": "user{{random}}", "Password": "Abc@123", "ConfirmPassword": "Abc@123", "FullName": "Nguyen Van A1", "Email": "a@mail.com",
    "ExpectedErrors": { "hoTen": "Họ và tên không chứa số !" }
  },
  {
    "Id": "TC_SU_07",
    "Title": "Full name empty",
    "Username": "user{{random}}", "Password": "Abc@123", "ConfirmPassword": "Abc@123", "FullName": "", "Email": "a@mail.com",
    "ExpectedErrors": { "hoTen": "Đây là trường bắt buộc !" }
  },
  {
    "Id": "TC_SU_08",
    "Title": "Email empty",
    "Username": "user{{random}}", "Password": "Abc@123", "ConfirmPassword": "Abc@123", "FullName": "Nguyen Van A", "Email": "",
    "ExpectedErrors": { "email": "Đây là trường bắt buộc !" }
  },
  {
    "Id": "TC_SU_09",
    "Title": "Confirm password empty while password is filled",
    "Username": "user{{random}}", "Password": "Abc@123", "ConfirmPassword": "", "FullName": "Nguyen Van A", "Email": "a@mail.com",
    "ExpectedErrors": { "confirmPassWord": "Mật khẩu không khớp !" }
